SUPABASE_URL=

# New keys (Settings → API Keys)
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback (Settings → API Keys → Legacy)
# SUPABASE_SERVICE_ROLE_KEY=

# Same signing key as sms-license/data/ed25519.sk (64 hex chars)
ED25519_SEED=

ADMIN_PASSWORD=change-me
PUBLIC_URL=https://edapps-admin.ahmerarain.com

# Hugging Face token for SMS in-app Help AI (https://huggingface.co/settings/tokens)
# Fine-grained with: Make calls to Inference Providers
HF_TOKEN=
# Optional model override (default: meta-llama/Llama-3.1-8B-Instruct:fastest)
# HELP_HF_MODEL=
# Optional rate limits (defaults: 6 AI asks per minute, then 3 minute pause)
# HELP_AI_MAX_PER_MIN=6
# HELP_AI_BLOCK_MS=180000
